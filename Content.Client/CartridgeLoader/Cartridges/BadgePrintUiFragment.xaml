<cartridges:BadgePrintUiFragment xmlns:cartridges="clr-namespace:Content.Client.CartridgeLoader.Cartridges"
                               xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                               xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                               xmlns:customControls="clr-namespace:Content.Client.Administration.UI.CustomControls"
                               xmlns="https://spacestation14.io"
                               Margin="1 0 2 0"
                               HorizontalExpand="True"
                               VerticalExpand="True">

    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">

        <Control MinHeight="20" />

        <!-- Row 1: Time Selection -->
        <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center">
            <Button
                Name="Button5Min"
                MinWidth="100"
                MinHeight="40"
                Margin="0 0 5 0"
                Text="5 Minutes"
                Access="Public"/>
            <Button
                Name="Button10Min"
                MinWidth="100"
                MinHeight="40"
                Margin="0 0 5 0"
                Text="10 Minutes"
                Access="Public"/>
            <Button
                Name="Button15Min"
                MinWidth="100"
                MinHeight="40"
                Margin="0 0 5 0"
                Text="15 Minutes"
                Access="Public"/>
            <Button
                Name="Button25Min"
                MinWidth="100"
                MinHeight="40"
                Margin="0 0 0 0"
                Text="25 Minutes"
                Access="Public"/>
        </BoxContainer>

        <Control VerticalExpand="True" />

        <!-- Department Selection Block -->
        <BoxContainer Orientation="Vertical" HorizontalAlignment="Center">

            <!-- Top Row of Departments -->
            <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center">
                <Button
                    Name="AllAccess"
                    MinWidth="125"
                    MinHeight="40"
                    Margin="0 0 5 5"
                    Text="{Loc 'id-card-access-level-all-access'}"
                    Access="Public"/>
                <Button
                    Name="CommandAccess"
                    MinWidth="125"
                    MinHeight="40"
                    Margin="0 0 5 5"
                    Text="{Loc 'id-card-access-level-command'}"
                    Access="Public"/>
                <Button
                    Name="SecurityAccess"
                    MinWidth="125"
                    MinHeight="40"
                    Margin="0 0 5 5"
                    Text="{Loc 'id-card-access-level-security'}"
                    Access="Public"/>
                <Button
                    Name="MedicalAccess"
                    MinWidth="125"
                    MinHeight="40"
                    Margin="0 0 0 5"
                    Text="{Loc 'id-card-access-level-medical'}"
                    Access="Public"/>
            </BoxContainer>

            <!-- Bottom Row of Departments -->
            <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center">
                <Button
                    Name="EngineeringAccess"
                    MinWidth="125"
                    MinHeight="40"
                    Margin="0 0 5 0"
                    Text="{Loc 'id-card-access-level-engineering'}"
                    Access="Public"/>
                <Button
                    Name="ResearchAccess"
                    MinWidth="125"
                    MinHeight="40"
                    Margin="0 0 5 0"
                    Text="{Loc 'id-card-access-level-research'}"
                    Access="Public"/>
                <Button
                    Name="CargoAccess"
                    MinWidth="125"
                    MinHeight="40"
                    Margin="0 0 5 0"
                    Text="{Loc 'id-card-access-level-cargo'}"
                    Access="Public"/>
                <Button
                    Name="ServiceAccess"
                    MinWidth="125"
                    MinHeight="40"
                    Margin="0 0 0 0"
                    Text="{Loc 'id-card-access-level-service'}"
                    Access="Public"/>
            </BoxContainer>

        </BoxContainer>

        <Control VerticalExpand="True" />

        <!-- Print Button -->
        <Button
            Name="Print"
            MinWidth="150"
            MinHeight="40"
            HorizontalAlignment="Center"
            Text="Print"
            Access="Public"/>

        <Control MinHeight="20" />

    </BoxContainer>

</cartridges:BadgePrintUiFragment>
